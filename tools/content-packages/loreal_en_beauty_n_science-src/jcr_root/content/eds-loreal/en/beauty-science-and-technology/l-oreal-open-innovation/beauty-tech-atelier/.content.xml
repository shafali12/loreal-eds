            </col5>
            <col6 jcr:primaryType="nt:unstructured">
              <image sling:resourceType="core/franklin/components/image/v1/image" jcr:primaryType="nt:unstructured" image="https://www.loreal.com/-/media/project/loreal/brand-sites/corp/master/lcorp/5-science-and-technology/loreal-open-innovation/l-oreal-innovation-program/beauty-tech-atelier-2025/img-5--how-to-apply.jpg?rev&#x3D;d03fe67e4949436da11ec2887b6b8a04&amp;hash&#x3D;2336CA0F922D0940F974101AA2566528" imageAlt="IMG 5 HOW TO APPLY"/>
            </col6>
          </row1>
          <row2 jcr:primaryType="nt:unstructured">
