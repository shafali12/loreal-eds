              <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;8K+&lt;/p&gt;&lt;p&gt;Digital, tech and data experts&lt;/p&gt;&lt;p&gt;No.1&lt;/p&gt;&lt;p&gt;World’s richest beauty database with millions of data points&lt;/p&gt;&lt;p&gt;120+M&lt;/p&gt;&lt;p&gt;Uses of our Beauty Tech services across 66 countries and 31 brands&lt;/p&gt;"/>
            </col1>
          </row1>
        </columns>
