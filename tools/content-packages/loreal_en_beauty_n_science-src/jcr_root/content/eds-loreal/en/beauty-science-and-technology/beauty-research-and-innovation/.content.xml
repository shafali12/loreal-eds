        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Focus On Research &amp; Innovation" titleType="h2"/>
        <text_1 sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;Dive into our constant search for cutting edge scientific discoveries and game-changing technologies, for more and more transparency and trust in our products, with no compromise on quality, efficacy and safety.&lt;/p&gt;"/>
